<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="top.nodaoli.MainController">
  <children>
    <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" VBox.vgrow="ALWAYS">
      <children>
            <Label layoutX="34.0" layoutY="47.0" prefHeight="40.0" prefWidth="126.0" text="源文件路径">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <Label layoutX="34.0" layoutY="127.0" prefHeight="40.0" prefWidth="177.0" text="软链接路径">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
            <TextField fx:id="sourcePathField" layoutX="34.0" layoutY="97.0" prefHeight="23.0" prefWidth="403.0" />
            <TextField fx:id="targetPathField" layoutX="34.0" layoutY="176.0" prefHeight="23.0" prefWidth="403.0" />
            <Button layoutX="455.0" layoutY="97.0" mnemonicParsing="false" text="浏览文件" onAction="#onBrowseSourceFile" />
            <Button layoutX="455.0" layoutY="176.0" mnemonicParsing="false" text="浏览" onAction="#onBrowseTarget" />
            <Button layoutX="542.0" layoutY="97.0" mnemonicParsing="false" text="浏览目录" onAction="#onBrowseSourceDir" />
            <Button layoutX="98.0" layoutY="240.0" mnemonicParsing="false" prefHeight="103.0" prefWidth="156.0" text="确定" onAction="#onConfirm">
               <font>
                  <Font size="36.0" />
               </font>
            </Button>
            <Button layoutX="387.0" layoutY="240.0" mnemonicParsing="false" prefHeight="103.0" prefWidth="156.0" text="取消" onAction="#onCancel">
               <font>
                  <Font size="36.0" />
               </font>
            </Button>
      </children>
    </AnchorPane>
  </children>
</VBox>
